@model IEnumerable<Inventory.Controllers.StockOutReportRow>

@{
    ViewData["Title"] = "Stock Out Report";
    var products = ViewBag.Products
        as IEnumerable<Inventory.Models.Product>
        ?? Enumerable.Empty<Inventory.Models.Product>();

    var rows = Model.ToList();
}

<h2>Stock Out Report</h2>
<p class="text-muted">
    Counter sales and spare parts consumed by workshop servicing.
</p>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@ViewBag.From"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@ViewBag.To"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Stock Out Type</label>
        <select name="type" class="form-select">
            <option value="All" selected="@(ViewBag.Type == "All")">
                All
            </option>
            <option value="Sale" selected="@(ViewBag.Type == "Sale")">
                Counter Sale
            </option>
            <option value="Service" selected="@(ViewBag.Type == "Service")">
                Workshop Service
            </option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Item</label>
        <select name="productId" class="form-select">
            <option value="">All items</option>
            @foreach (var p in products)
            {
                <option value="@p.Id"
                        selected="@(ViewBag.ProductId is int id && id == p.Id)">
                    @p.PartNumber - @p.Name
                </option>
            }
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<div class="mb-3">
    <a asp-action="ExportStockOutCsv"
       asp-route-from="@ViewBag.From"
       asp-route-to="@ViewBag.To"
       asp-route-type="@ViewBag.Type"
       asp-route-productId="@ViewBag.ProductId"
       class="btn btn-success">
        Export Stock Out CSV
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-body">
            <div class="text-muted">Total quantity issued</div>
            <h4>@rows.Sum(r => r.Quantity).ToString("N3")</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-body">
            <div class="text-muted">Cost value of issued stock</div>
            <h4>@rows.Sum(r => r.CostValue).ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-body">
            <div class="text-muted">Value at recorded selling prices</div>
            <h4>@rows.Sum(r => r.SalesValue).ToString("N2")</h4>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Part Code</th>
                <th>Item</th>
                <th>Type</th>
                <th>Reference</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Unit Cost</th>
                <th class="text-end">Cost Value</th>
                <th class="text-end">Selling Value</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in rows)
        {
            <tr>
                <td>@r.Date.ToLocalTime().ToString("dd-MMM-yyyy")</td>
                <td>@r.PartNumber</td>
                <td>@r.ProductName</td>
                <td>
                    @(r.MovementType == Inventory.Models.StockMovementType.CounterSale
                        ? "Counter Sale" : "Workshop Service")
                </td>
                <td>@r.ReferenceNumber</td>
                <td class="text-end">@r.Quantity.ToString("N3")</td>
                <td class="text-end">@r.UnitCost.ToString("N2")</td>
                <td class="text-end">@r.CostValue.ToString("N2")</td>
                <td class="text-end">@r.SalesValue.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
