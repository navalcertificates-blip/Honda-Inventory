@model IEnumerable<Inventory.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Products</h2>
    <a asp-action="Create" class="btn btn-primary">Add Product</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input name="search" value="@ViewBag.Search"
               class="form-control"
               placeholder="Search part code or item name" />
        <button class="btn btn-outline-primary">Search</button>
    </div>
</form>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Part Code</th>
                <th>Item</th>
                <th>Category</th>
                <th>Unit</th>
                <th class="text-end">Purchase</th>
                <th class="text-end">Selling</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.PartNumber</td>
                    <td>@p.Name</td>
                    <td>@p.Category</td>
                    <td>@p.Unit</td>
                    <td class="text-end">@p.PurchaseRate.ToString("N2")</td>
                    <td class="text-end">@p.SellingPrice.ToString("N2")</td>
                    <td>@(p.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@p.Id"
                           class="btn btn-sm btn-outline-primary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
