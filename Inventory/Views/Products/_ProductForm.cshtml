@model Inventory.Models.Product

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="PartNumber" class="form-label"></label>
    <input asp-for="PartNumber" class="form-control" />
    <span asp-validation-for="PartNumber" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Category" class="form-label"></label>
    <select asp-for="Category" class="form-select">
        <option>Spare Parts</option>
        <option>Lubricants</option>
        <option>Accessories</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="Unit" class="form-label"></label>
    <select asp-for="Unit" class="form-select">
        <option>Piece</option>
        <option>Set</option>
        <option>Pack</option>
        <option>Litre</option>
        <option>Millilitre</option>
        <option>Pair</option>
    </select>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="PurchaseRate" class="form-label"></label>
        <input asp-for="PurchaseRate" class="form-control" />
        <span asp-validation-for="PurchaseRate"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="SellingPrice" class="form-label"></label>
        <input asp-for="SellingPrice" class="form-control" />
        <span asp-validation-for="SellingPrice"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="ReorderLevel" class="form-label"></label>
        <input asp-for="ReorderLevel" class="form-control" />
        <span asp-validation-for="ReorderLevel"
              class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label"></label>
</div>

<button type="submit" class="btn btn-primary">Save Product</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
