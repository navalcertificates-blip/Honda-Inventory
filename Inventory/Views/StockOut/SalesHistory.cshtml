@model IEnumerable<Inventory.Models.Sale>

@{
    ViewData["Title"] = "Sales History";
}

<h2>Counter Sales History</h2>

<a asp-action="Sale" class="btn btn-primary mb-3">New Sale</a>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Invoice</th>
                <th>Customer</th>
                <th>Phone</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SaleDate.ToLocalTime().ToString("dd-MMM-yyyy")</td>
                <td>
                        <a asp-action="Details"
                           asp-route-id="@s.Id"
                           class="text-primary fw-bold text-decoration-none">
                            @s.InvoiceNumber
                        </a>
                    </td>
                <td>@s.CustomerName</td>
                <td>@s.CustomerPhone</td>
                <td class="text-end">@s.TotalAmount.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
