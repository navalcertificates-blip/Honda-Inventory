@model Inventory.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Invoice Details</h2>

    <a asp-action="Index" class="btn btn-secondary">
        Back to Sales
    </a>
</div>

<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Invoice Information</h5>
    </div>

    <div class="card-body">
        <div class="row">

            <div class="col-md-4 mb-3">
                <strong>Invoice Number:</strong>
                <div>@Model.InvoiceNumber</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Date:</strong>
                <div>@Model.SaleDate.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Customer:</strong>
                <div>@Model.CustomerName</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Phone:</strong>
                <div>@Model.CustomerPhone</div>
            </div>

        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">Purchased Items</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int count = 1;
                    }

                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@count</td>

                            
                            <td>@item.Product?.Name</td>

                            <td class="text-end">
                                @item.Quantity.ToString("N2")
                            </td>

                            <td class="text-end">
                                @item.UnitPrice.ToString("N2")
                            </td>

                            <td class="text-end">
                                @item.LineTotal.ToString("N2")
                            </td>
                        </tr>

                        count++;
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">
                            Grand Total:
                        </th>

                        <th class="text-end">
                            @Model.TotalAmount.ToString("N2")
                        </th>
                    </tr>
                </tfoot>

            </table>

        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Back to Sales History
    </a>

    <button onclick="window.print()"
            class="btn btn-primary">
        Print Invoice
    </button>
</div>