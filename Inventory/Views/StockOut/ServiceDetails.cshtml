
@model Inventory.Models.ServiceJob

@{
    ViewData["Title"] = "Service Job Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Service Job Details</h2>

    <div>
        <a asp-action="Index" class="btn btn-secondary">
            Back to Service History
        </a>

        <button onclick="window.print()"
                class="btn btn-primary">
            Print Job Card
        </button>
    </div>
</div>

<!-- SERVICE HEADER -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Service Information</h5>
    </div>

    <div class="card-body">
        <div class="row">

            <div class="col-md-4 mb-3">
                <strong>Job Card Number:</strong>
                <div>@Model.JobCardNumber</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Job Date:</strong>
                <div>
                    @Model.JobDate.ToLocalTime().ToString("dd-MMM-yyyy hh:mm tt")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Customer Name:</strong>
                <div>@Model.CustomerName</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Phone:</strong>
                <div>@Model.CustomerPhone</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Vehicle Registration:</strong>
                <div>@Model.VehicleRegistration</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Vehicle Model:</strong>
                <div>@Model.VehicleModel</div>
            </div>

            <div class="col-12 mb-2">
                <strong>Remarks:</strong>
                <div>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</div>
            </div>

        </div>
    </div>
</div>


<!-- PARTS / ITEMS USED -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Spare Parts / Items Used</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Part Number</th>
                        <th>Product Name</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int count = 1;
                    }

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@count</td>

                                <td>
                                    @item.Product?.PartNumber
                                </td>

                                <td>
                                    @item.Product?.Name
                                </td>

                                <td class="text-end">
                                    @item.Quantity.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @item.UnitPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @item.LineTotal.ToString("N2")
                                </td>
                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No spare parts or items used.
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end">
                            Parts Total:
                        </th>

                        <th class="text-end">
                            @Model.PartsTotal.ToString("N2")
                        </th>
                    </tr>
                </tfoot>

            </table>

        </div>
    </div>
</div>


<!-- SERVICE BILL SUMMARY -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Bill Summary</h5>
    </div>

    <div class="card-body">

        <div class="row justify-content-end">

            <div class="col-md-5">

                <div class="d-flex justify-content-between mb-2">
                    <strong>Parts Total:</strong>
                    <span>@Model.PartsTotal.ToString("N2")</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <strong>Labour Charges:</strong>
                    <span>@Model.LabourCharges.ToString("N2")</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between fs-5">
                    <strong>Grand Total:</strong>

                    <strong class="text-primary">
                        @Model.TotalAmount.ToString("N2")
                    </strong>
                </div>

            </div>

        </div>

    </div>
</div>


<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Back to Service History
    </a>

    <button onclick="window.print()"
            class="btn btn-primary">
        Print Job Card
    </button>
</div>


<style>
    @@media print {
        .btn,
        nav,
        .sidebar {
            display: none !important;
        }

        body {
            font-size: 12px;
        }

        .card {
            border: 1px solid #999 !important;
            break-inside: avoid;
        }

        .card-header {
            background-color: #eee !important;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        table {
            width: 100%;
        }
    }
</style>
